# Dependencies for the example test harness in tests/ — the app itself has none.
node_modules/

# Modern npm auto-creates these the first time `npm install jsdom playwright` (see tests/README.md)
# runs in a directory with no package.json yet. The harness deliberately has no pinned dependency
# manifest, so these are a side effect of following the documented setup steps, not real repo content.
tests/package.json
tests/package-lock.json

# Generated by tests/playwright-visual-tests.js (screenshots + sample PDF) — regenerated on each run.
tests/output/

# OS cruft
.DS_Store
Thumbs.db

# Editor cruft
.vscode/
.idea/

